{
  "datasets": [
    {
      "name": "c502625c",
      "displayName": "students",
      "config": {
        "version": "1.1",
        "source": "central_dataplatform_8259550397534943.default.students",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "6f4bab4c",
      "displayName": "First_Letter_Count",
      "queryLines": [
        "with result as (\r\n",
        "    select left(email,1) as FirstCharacter from students\r\n",
        ") select FirstCharacter,count(FirstCharacter) from result group by firstcharacter\r\n",
        "order by count(firstcharacter) desc"
      ]
    },
    {
      "name": "025948d5",
      "displayName": "First_Name_Count",
      "queryLines": [
        "select firstName FirstName,COunt(firstName) CountOfFirstName from students group by firstName order by CountOfFirstName desc"
      ]
    },
    {
      "name": "a24b89d8",
      "displayName": "Gender_Count",
      "queryLines": [
        "select gender,count(gender) as gender_count from students group by gender order by gender_count desc"
      ]
    },
    {
      "name": "f60aed1c",
      "displayName": "Yearly_Average_Salary",
      "queryLines": [
        "select \r\n",
        "    enrollmentYear as EnrollYear,\r\n",
        "    ceiling(avg(salary)) as AverageSalary \r\n",
        "from students \r\n",
        "group by enrollmentYear \r\n",
        "order by enrollmentYear "
      ]
    },
    {
      "name": "f81b3c37",
      "displayName": "Major_Yearly_Average_Gpa",
      "queryLines": [
        "select \r\n",
        "    Major,\r\n",
        "    EnrollmentYear as EnrollYear,\r\n",
        "    round(avg(gpa),3) as AverageGpa \r\n",
        "from students \r\n",
        "group by major,enrollmentYear \r\n",
        "order by major,enrollmentYear "
      ]
    },
    {
      "name": "1cdb7440",
      "displayName": "Active_Status_Statistics",
      "queryLines": [
        "select \r\n",
        "case when isActive = true then 'Active' else 'Inactive' end as ActiveStatus, \r\n",
        "count(isActive) as Amount\r\n",
        "from students group by isActive"
      ]
    },
    {
      "name": "3d7adef0",
      "displayName": "Height_Group_Distribution",
      "queryLines": [
        "WITH bounds AS (\r\n",
        "  SELECT\r\n",
        "    MIN(height) AS shortest,\r\n",
        "    MAX(height) AS tallest,\r\n",
        "    (MAX(height) - MIN(height)) / 4 AS gap\r\n",
        "  FROM\r\n",
        "    students\r\n",
        ")\r\n",
        "SELECT\r\n",
        "  CASE\r\n",
        "    WHEN s.height BETWEEN b.shortest AND b.shortest + b.gap THEN '1. Short'\r\n",
        "    WHEN s.height BETWEEN b.shortest + b.gap AND b.shortest + 2 * b.gap THEN '2.Medium'\r\n",
        "    WHEN s.height BETWEEN b.shortest + 2 * b.gap AND b.shortest + 3 * b.gap THEN '3.Tall'\r\n",
        "    WHEN s.height BETWEEN b.shortest + 3 * b.gap AND b.tallest THEN '4.Very Tall'\r\n",
        "  END AS height_group,\r\n",
        "  COUNT(*) AS num\r\n",
        "FROM\r\n",
        "  students s CROSS JOIN bounds b\r\n",
        "GROUP BY\r\n",
        "  height_group\r\n",
        "ORDER BY\r\n",
        "  height_group"
      ]
    }
  ],
